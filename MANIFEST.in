include README.md
include LICENSE
include THIRD_PARTY_NOTICES.md
include pyproject.toml

recursive-include adalib *.py
recursive-include examples *.py
recursive-include tests *.py

prune paper_artifacts
prune docs
prune tests/lv_inverse_outputs

recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.npz
recursive-exclude * *.h5
recursive-exclude * *.png
recursive-exclude * *.zip
